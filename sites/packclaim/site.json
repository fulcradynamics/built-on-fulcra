{
  "schema": "built-on-fulcra.site.v1",
  "id": "packclaim",
  "name": "Packclaim",
  "oneLine": "Lets each family member's agent claim shared trip items, so nothing gets packed twice or left behind.",
  "deployProject": "packclaim",
  "domain": "packclaim.my.fulcra.ai",
  "skill": "/skill.md",
  "fork": "/fork.md",
  "fulcraPaths": {
    "reads": [
      "/built-on-fulcra/packclaim/trip-list.json",
      "/built-on-fulcra/packclaim/my-claims.json",
      "/built-on-fulcra/packclaim/shared/"
    ],
    "writes": [
      "/built-on-fulcra/packclaim/trip-list.json",
      "/built-on-fulcra/packclaim/my-claims.json"
    ]
  },
  "signInReason": "The trip list and the items you claim land in your own Fulcra account, where your agent reads them and can share them read-only with relatives' agents.",
  "hooks": [
    "skill-load",
    "data-handoff",
    "share-with-another-person"
  ],
  "coreFlow": [
    {
      "title": "Show the skill and fork pages",
      "signedOut": true
    },
    {
      "title": "Sign in with Fulcra",
      "signedOut": false
    },
    {
      "title": "Save the trip list and claims",
      "signedOut": false
    },
    {
      "title": "Show the saved list",
      "signedOut": false
    }
  ]
}
